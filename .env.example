# ==========================================
# WAGate Environment Configuration
# ==========================================

# Server Configuration
PORT=3000
API_KEY=secret-token-12345

# WhatsApp Session Storage Mode ('file' | 'mongodb')
SESSION_STORAGE=file
SESSIONS_DIR=./sessions

# MongoDB URI (Required if SESSION_STORAGE=mongodb or SAVE_MESSAGES_TO_DB=true)
MONGODB_URI=mongodb://localhost:27017/wagate

# Message & Media Persistence
SAVE_MESSAGES_TO_DB=false
AUTO_DOWNLOAD_MEDIA=true
MEDIA_STORAGE_DIR=./storage/media

# Outbound Safe Queue Anti-Ban Delays (in milliseconds)
QUEUE_MIN_DELAY_MS=1500
QUEUE_MAX_DELAY_MS=3000

# Optional Inbound Webhook URL to forward incoming WhatsApp messages
WEBHOOK_URL=
